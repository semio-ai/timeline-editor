{
  "name": "@semio/timeline-editor",
  "description": "Higher-level visualization and editing components for interacting with assets.",
  "version": "0.6.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/semio-ai/timeline-editor.git"
  },
  "homepage": "https://github.com/semio-ai/timeline-editor#readme",
  "bugs": "https://github.com/semio-ai/timeline-editor/issues",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "source": "./src/index.tsx",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./styles.css": "./src/styles.css",
    "./theme.css": "./src/theme.css",
    "./dist/styles.css": "./dist/styles.css",
    "./format": {
      "types": "./dist/format.d.ts",
      "source": "./src/format.ts",
      "import": "./dist/format.mjs",
      "require": "./dist/format.js"
    }
  },
  "license": "Apache-2.0",
  "files": [
    "dist/**",
    "src/styles.css",
    "src/theme.css",
    "NOTICE",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "tsup src/index.tsx src/format.ts --format esm,cjs --dts --external react --external three --external @react-three/fiber --external @react-three/drei --publicDir",
    "dev": "tsup src/index.tsx src/format.ts --format esm,cjs --watch --dts --external react --external three --external @react-three/fiber --external @react-three/drei --publicDir",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:once": "vitest run",
    "clean": "rm -rf .turbo && rm -rf node_modules && rm -rf dist",
    "test:unit": "vitest run",
    "test": "vitest run",
    "conformance:generate": "tsup conformance/generate.ts --format cjs --out-dir dist/conformance && node dist/conformance/generate.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "changeset": "changeset",
    "test:release": "node .github/tests/release-harness.mjs",
    "storybook": "storybook dev -h localhost -p 6008 --no-open",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@react-three/drei": "^10.0.0",
    "@react-three/fiber": "^9.0.0",
    "@semio/data": "^0.1.0",
    "@semio/ui": "^0.5.0",
    "@semio/utils": "^0.6.0",
    "@solar-icons/react-perf": "^2.1.0",
    "@tailwindcss/postcss": "^4.1.3",
    "@use-gesture/react": "^10.3.1",
    "clsx": "^2.1.1",
    "culori": "^4.0.2",
    "d3-interpolate": "^3.0.1",
    "d3-scale": "^4.0.2",
    "fast-deep-equal": "^3.1.3",
    "flubber": "^0.4.2",
    "immer": "^10.0.3",
    "lodash": "^4.18.1",
    "motion": "^12.23.11",
    "number-precision": "^1.6.0",
    "react": "^19.1.0",
    "react-use-measure": "^2.1.1",
    "react-use-refs": "^1.0.1",
    "three": "^0.170.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@chromatic-com/storybook": "^5.6.0",
    "@eslint/js": "^10.0.1",
    "@storybook/addon-designs": "^12.0.0",
    "@storybook/addon-docs": "^10.6.4",
    "@storybook/addon-links": "^10.6.4",
    "@storybook/react-vite": "^10.6.4",
    "@testing-library/react": "^16.3.3",
    "@types/culori": "^4.0.0",
    "@types/d3-interpolate": "^3.0.4",
    "@types/d3-scale": "^4.0.8",
    "@types/flubber": "^0.4.0",
    "@types/lodash": "^4.17.27",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^10.6.4",
    "eslint-plugin-tailwindcss": "4.4.0",
    "eslint-plugin-unicorn": "^79.0.0",
    "globals": "^17.11.0",
    "js-yaml": "^5.5.0",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "react-docgen": "^8.0.4",
    "react-docgen-typescript": "^2.2.2",
    "storybook": "^10.3.3",
    "tailwindcss": "^4.3.3",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
