{
  "name": "@semio/animation",
  "description": "Higher-level visualization and editing components for interacting with assets.",
  "version": "0.2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/semio-ai/semio_studio.git",
    "directory": "packages/animation"
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "source": "./src/index.tsx",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./styles.css": "./src/styles.css",
    "./theme.css": "./src/theme.css",
    "./dist/styles.css": "./dist/styles.css"
  },
  "license": "MIT",
  "files": [
    "dist/**",
    "src/styles.css",
    "src/theme.css"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "tsup src/index.tsx --format esm,cjs --dts --external react --external three --external @react-three/fiber --external @react-three/drei --publicDir",
    "dev": "tsup src/index.tsx --format esm,cjs --watch --dts --external react --external three --external @react-three/fiber --external @react-three/drei --publicDir",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "test:once": "vitest run",
    "clean": "rm -rf .turbo && rm -rf node_modules && rm -rf dist",
    "test:unit": "vitest run",
    "test": "vitest run"
  },
  "dependencies": {
    "@react-three/drei": "^10.0.0",
    "@react-three/fiber": "^9.0.0",
    "@semio/ui": "*",
    "@semio/utils": "*",
    "@solar-icons/react-perf": "^2.1.0",
    "@tabler/icons-react": "^3.34.0",
    "@tailwindcss/postcss": "^4.1.3",
    "@use-gesture/react": "^10.3.1",
    "clsx": "^2.1.1",
    "culori": "^4.0.2",
    "d3-interpolate": "^3.0.1",
    "d3-scale": "^4.0.2",
    "fast-deep-equal": "^3.1.3",
    "flubber": "^0.4.2",
    "immer": "^10.0.3",
    "lodash": "^4.18.1",
    "motion": "^12.23.11",
    "number-precision": "^1.6.0",
    "react": "^19.1.0",
    "react-use-measure": "^2.1.1",
    "react-use-refs": "^1.0.1",
    "three": "^0.170.0",
    "zustand": "^5.0.2"
  },
  "peerDependencies": {
    "@tabler/icons-react": "^3.34.0"
  },
  "devDependencies": {
    "@semio/eslint-config": "*",
    "@semio/typescript-config": "*",
    "@testing-library/react": "^16.0.1",
    "@types/culori": "^4.0.0",
    "@types/d3-interpolate": "^3.0.4",
    "@types/d3-scale": "^4.0.8",
    "@types/flubber": "^0.4.0",
    "@types/lodash": "^4.14.202",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^5.0.2",
    "@vitest/browser": "^3.2.4",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.5.10",
    "tailwindcss": "^4.1.3",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3",
    "vitest": "^3.2.4"
  },
  "publishConfig": {
    "access": "public"
  }
}
