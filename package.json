{
  "name": "@semio/animation",
  "description": "Higher-level visualization and editing components for interacting with assets.",
  "version": "0.0.0",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "license": "MIT",
  "files": ["dist/**", "dist/index.css"],
  "sideEffects": ["**/*.css"],
  "scripts": {
    "build": "tsup src/index.tsx --format esm,cjs --dts src/index.tsx --external react",
    "dev": "tsup src/index.tsx --format esm,cjs --watch --dts src/index.tsx --external react",
    "lint": "eslint . --max-warnings 0",
    "clean": "rm -rf .turbo && rm -rf node_modules && rm -rf dist"
  },
  "dependencies": {
    "@mantine/hooks": "^7.7.1",
    "@react-spring/web": "^9.7.3",
    "@semio/ui": "*",
    "@semio/utils": "*",
    "@tabler/icons-react": "^2.46.0",
    "@use-gesture/react": "^10.3.0",
    "@visx/drag": "^3.3.0",
    "@visx/responsive": "^3.3.0",
    "@visx/scale": "^3.5.0",
    "lodash": "^4.17.21",
    "react-use-measure": "^2.1.1",
    "immer": "^10.0.3",
    "zustand": "^4.5.1"
  },
  "peerDependencies": {
    "@mantine/core": "^7.7.1",
    "@tabler/icons-react": "^2.46.0"
  },
  "devDependencies": {
    "@semio/eslint-config": "*",
    "@semio/tailwind-config": "*",
    "@semio/typescript-config": "*",
    "@types/lodash": "^4.14.202",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.56.0",
    "postcss": "^8.4.38",
    "react": "^18.3.0",
    "tailwindcss": "^3.4.4",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
